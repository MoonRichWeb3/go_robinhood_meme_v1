# Robinhood Chain 公网只读验收配置；公开 RPC 有限流，仅适合开发测试。
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_CHAIN_ID=4663
# 0 表示数据库无水位时动态从当前链头前 10 块开始。
RH_FROM_BLOCK=0
RH_HTTP_UA=go-robinhood-meme/v0
RH_RPC_TIMEOUT_MS=8000

# 第三方 Blockmachine 仅用于 callTracer；无密钥，与官方扫块 RPC 隔离。
RH_TRACE_RPC_URL=https://rpc-robinhood.blockmachine.io
RH_TRACE_TIMEOUT_MS=8000
RH_POLL_MS=200
RH_MAX_BLOCKS_PER_TICK=10

# 容器内存储与只读 HTTP。
RH_SQLITE_PATH=/data/robinhood_meme.sqlite3
RH_HTTP_ADDR=0.0.0.0:8888
RH_HTTP_QUERY_MS=3000
RH_HEALTH_LAG_WARN=50
LOG_LEVEL=info

# 名单、评分、信号与展示价节拍。
RH_WALLET_RELOAD_MS=1000
RH_SCORE_INTERVAL_SEC=3600
RH_SIGNAL_INTERVAL_SEC=3600
RH_PRICE_FLUSH_SEC=3
RH_DIRTY_TOKEN_CAP=5000

# Binance 公开 ETH/USDT 行情，无需 API Key。
RH_BINANCE_BASE_URL=https://api.binance.com
RH_BINANCE_ETH_SYMBOL=ETHUSDT
RH_ETHUSD_POLL_SEC=10
RH_BINANCE_TIMEOUT_MS=3000
RH_ETHUSD_TTL_SEC=30
RH_ETHUSD_STALE_SEC=300

# wallet_events 保留七天，每小时按有界批次清理。
RH_EVENT_RETENTION_DAYS=7
RH_EVENT_PURGE_INTERVAL_SEC=3600
RH_EVENT_PURGE_BATCH=500
RH_EVENT_PURGE_SLEEP_MS=100
RH_EVENT_PURGE_MAX_PER_RUN=5000
